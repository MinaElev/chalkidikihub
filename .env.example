# Supabase (same project as v3 — users, listings and bookings carry over)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://chalkidikihub.gr

# Required: Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Optional: lets scripts call /api/revalidate without a session
REVALIDATE_TOKEN=

# Third-party data
NEXT_PUBLIC_OCM_API_KEY=
NEXT_PUBLIC_OWM_API_KEY=
OPENAI_API_KEY=

# Google Search Console OAuth (admin → SEO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GSC_SITE_URL=

# Stripe (owner billing + PMS direct booking)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Optional integrations used by the ported admin/owner tools
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GOOGLE_PLACES_API_KEY=
UNSPLASH_ACCESS_KEY=
INDEXNOW_KEY=
MAKE_LMD_WEBHOOK_URL=
MARKETING_FEED_KEY=
PMS_ICAL_SECRET=
