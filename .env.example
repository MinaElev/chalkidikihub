# Supabase (same project as v3 — users, listings and bookings carry over)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://chalkidikihub.gr

# Required: Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# Optional: lets scripts call /api/revalidate without a session
REVALIDATE_TOKEN=

# Third-party data
NEXT_PUBLIC_OCM_API_KEY=
NEXT_PUBLIC_OWM_API_KEY=
OPENAI_API_KEY=

# Google Search Console OAuth (admin → SEO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GSC_SITE_URL=

# Viva Smart Checkout (owner billing). Self Care → Settings → API Access.
# VIVA_ENV=demo uses demo.vivapayments.com; set to live for real payments.
# Payment source (Sales → Online Payments → Websites/Apps): success AND failure
# URL = /api/billing/viva/return. Webhook URL = /api/viva/webhook
# (events: Transaction Payment Created, Transaction Reversal Created).
VIVA_ENV=demo
VIVA_CLIENT_ID=
VIVA_CLIENT_SECRET=
VIVA_SOURCE_CODE=
VIVA_MERCHANT_ID=
VIVA_API_KEY=

# Optional integrations used by the ported admin/owner tools
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GOOGLE_PLACES_API_KEY=
UNSPLASH_ACCESS_KEY=
INDEXNOW_KEY=
MAKE_LMD_WEBHOOK_URL=
MARKETING_FEED_KEY=
PMS_ICAL_SECRET=
